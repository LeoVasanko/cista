{
  "name": "cista-frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format --check .",
    "check": "biome check ."
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@imengyu/vue3-context-menu": "^1.5.3",
    "@vueuse/core": "^14.1.0",
    "esbuild": "^0.27.2",
    "lodash": "^4.17.23",
    "lodash-es": "^4.17.23",
    "paskia": "^0.1.2",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "unplugin-vue-components": "^31.0.0",
    "vite-svg-loader": "^5.1.0",
    "vue": "^3.5.27",
    "vue-router": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tsconfig/node18": "^18.2.6",
    "@types/jsdom": "^27.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.1.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^27.4.0",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  }
}
